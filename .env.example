# Copy to .env and fill in real values. Never commit the real .env.

# OpenRouteService (routing / matrix)
ORS_API_KEY=
# ORS_BASE_URL=https://api.openrouteservice.org

# Geocoding providers
GOOGLE_MAPS_API_KEY=
# MAPBOX_ACCESS_TOKEN=

# Provider selection: google | openroute | mapbox
GEOCODE_PROVIDER=google

# Defaults
DEFAULT_COUNTRY_CODE=KH
