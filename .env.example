# Copy to .env and fill in real values. Never commit the real .env.

# OpenRouteService (routing / matrix)
ORS_API_KEY=
# ORS_BASE_URL=https://api.openrouteservice.org

# Geocoding providers
GOOGLE_MAPS_API_KEY=
# MAPBOX_ACCESS_TOKEN=

# Provider selection: google | openroute | mapbox
GEOCODE_PROVIDER=google

# Service authentication
# Shared API key the NestJS backend sends via the X-API-Key header on every
# request except /health. Required at startup.
SERVICE_API_KEY=

# Defaults
DEFAULT_COUNTRY_CODE=KH

# Logging
LOG_LEVEL=INFO
# LOG_FORMAT=json   # or "text" for readable local dev output
